def now() -> datetime:
    return datetime.now(TZ)


def log(message: str) -> None:
    line = f'{now():%F %T} | vpn-guard | {message}\n'
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        if LOG_FILE.exists() and LOG_FILE.stat().st_size > 512_000:
            tail = LOG_FILE.read_bytes()[-200_000:]
            LOG_FILE.write_bytes(tail[tail.find(b'\n') + 1:])
        with LOG_FILE.open('a', encoding='utf-8') as stream:
            stream.write(line)
    except OSError:
        pass
    print(line, end='', file=sys.stderr)


def write_private(path: Path, text: str, mode: int = 0o600) -> None:
    """Атомарная запись файла с заданными правами."""
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=f'.{path.name}.')
    try:
        with os.fdopen(handle, 'w', encoding='utf-8') as stream:
            stream.write(text)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(temporary)
        raise


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    write_private(STATE_FILE, json.dumps(state, ensure_ascii=False, indent=1))


def read_env() -> dict[str, str]:
    values = {}
    try:
        for line in ENV_FILE.read_text(encoding='utf-8').splitlines():
            if '=' in line and not line.lstrip().startswith('#'):
                key, _, value = line.partition('=')
                values[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


# ──────────────────────────────── сеть и curl ────────────────────────────────

def cfg_quote(value: str) -> str:
    """Строка для конфигурации curl, читаемой со стандартного ввода."""
    escaped = (value.replace('\\', '\\\\').replace('"', '\\"')
               .replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t'))
    return f'"{escaped}"'


def sanitize(text: str) -> str:
    return re.sub(r'https?://\S+', '<ссылка>', text).strip()[:200]


def curl(url: str, *, proxy: str | None = None, user: str | None = None, timeout: int = 10,
         headers: dict[str, str] | None = None, post: dict[str, str] | None = None
         ) -> tuple[int, bytes, str]:
    """Возвращает (HTTP-код, тело, ошибка). Код 0 — соединение не установилось.

    Адрес, заголовки и данные идут через стандартный ввод, чтобы не светиться в `ps`.
    `user='nobody'` запускает curl мимо прозрачного заворота (правило по uid в iptables).
    """
    if '\n' in url or '\r' in url:
        raise GuardError('в ссылке есть перевод строки')
    lines = ['silent', 'show-error', f'max-time = {int(timeout)}',
             f'connect-timeout = {min(int(timeout), 10)}',
             f'url = {cfg_quote(url)}', 'write-out = "\\n__HTTP__%{http_code}"']
    if proxy:
        lines.append(f'proxy = {cfg_quote(proxy)}')
    for name, value in (headers or {}).items():
        if '\n' in name + value:
            raise GuardError('в заголовке есть перевод строки')
        lines.append(f'header = {cfg_quote(f"{name}: {value}")}')
    for name, value in (post or {}).items():
        lines.append(f'data-urlencode = {cfg_quote(f"{name}={value}")}')
    command = ['curl', '-q', '-K', '-']
    if user:
        uid, gid = USERS[user]
        command = ['setpriv', f'--reuid={uid}', f'--regid={gid}', '--clear-groups'] + command
    try:
        result = subprocess.run(command, input='\n'.join(lines).encode(), capture_output=True,
                                timeout=timeout + 15)
    except (subprocess.TimeoutExpired, OSError) as error:
        return 0, b'', sanitize(str(error))
    body, _, tail = result.stdout.rpartition(b'\n__HTTP__')
    try:
        code = int(tail.strip() or 0)
    except ValueError:
        code = 0
    return code, body, sanitize(result.stderr.decode('utf-8', 'replace'))


def probe_round(port: int, timeout: int) -> dict:
    """Один круг: все службы параллельно через SOCKS на порту `port`.

    Служба засчитывается при любом HTTP-ответе: важно, что трафик через узел прошёл.
    """
    proxy = f'socks5h://127.0.0.1:{port}'

    def one(url: str) -> tuple[int, bytes, int]:
        started = time.monotonic()
        code, body, _ = curl(url, proxy=proxy, timeout=timeout)
        return code, body, round((time.monotonic() - started) * 1000)

    with ThreadPoolExecutor(len(SERVICES)) as pool:
        results = list(pool.map(one, [url for _, url in SERVICES]))
    code, body, _ = results[-1]
    country = trace_country(code, body) or fallback_country(proxy=proxy, timeout=timeout)
    passed = [result[2] for (name, _), result in zip(SERVICES, results) if result[0] and name in REQUIRED]
    return dict(passed={name: result[0] != 0 for (name, _), result in zip(SERVICES, results)},
                country=country, ms=min(passed) if passed else None)


def trace_country(code: int, body: bytes) -> str | None:
    match = re.search(rb'^loc=(\w+)', body, re.M) if code == 200 else None
    return match.group(1).decode() if match else None


def fallback_country(*, proxy: str | None = None, user: str | None = None, timeout: int = 10) -> str | None:
    code, body, _ = curl(COUNTRY_FALLBACK, proxy=proxy, user=user, timeout=timeout)
    text = body.decode('ascii', 'replace').strip()
    return text if code == 200 and re.fullmatch(r'[A-Z]{2}', text) else None


def probe_egress(port: int = SOCKS_PORT, timeout: int = 10, rounds: int = ROUNDS,
                 early_exit: bool = True) -> dict:
    """Строгая проверка выхода через SOCKS Xray (он идёт в исходящее «proxy»).

    Выход рабочий, если каждая обязательная служба ответила хотя бы в rounds-1 кругах
    (при одном круге — в нём) и страна выхода определилась и есть в очереди PLACES.
    Остальные службы попадают в журнал (`extra`), но на решение не влияют.
    Безнадёжный узел бросаем, не докручивая круги.
    """
    need = max(rounds - 1, 1)
    hits = {name: 0 for name, _ in SERVICES}
    countries, timings, done = [], [], 0
    for done in range(1, rounds + 1):
        result = probe_round(port, timeout)
        for name, passed in result['passed'].items():
            hits[name] += passed
        if result['country']:
            countries.append(result['country'])
        if result['ms'] is not None:
            timings.append(result['ms'])
        if early_exit and any(hits[name] + rounds - done < need for name in REQUIRED):
            break
    lost = [name for name, count in hits.items() if count + rounds - done < need]  # без шансов добрать
    failed = [name for name in lost if name in REQUIRED]
    extra = [name for name in lost if name not in REQUIRED]
    foreign = sorted({country for country in countries if country not in COUNTRIES})
    problem = ('не открываются: ' + ', '.join(failed) if failed
               else f'выход из страны {", ".join(foreign)}, её нет в очереди' if foreign
               else 'страну выхода определить не вышло' if not countries else None)
    score = sum(hits[name] for name in REQUIRED)
    return dict(ok=problem is None, ms=min(timings) if timings else None,
                country=countries[-1] if countries else None, failed=failed, extra=extra, problem=problem,
                score=f'{score} из {done * len(REQUIRED)}')


def egress_health() -> dict:
    """Рабочий выход: быстрый круг; при сбое — строгая проверка, через 20 секунд ещё одна."""
    quick = probe_egress(rounds=1)
    if quick['ok']:
        return quick
    strict = probe_egress()
    if strict['ok']:
        return strict
    time.sleep(20)
    return probe_egress()


def redirect_ready() -> bool:
    return (sh('iptables', '-t', 'nat', '-C', 'OUTPUT', '-p', 'tcp', '-j', CHAIN).returncode == 0
            and 'REDIRECT' in sh('iptables', '-t', 'nat', '-S', CHAIN).stdout)


def probe_transparent() -> bool:
    """Путь, которым ходят все службы: обычный пользователь → заворот → узел из очереди.

    Одного ответа мало: мимо туннеля ответ тоже придёт. Поэтому смотрим страну выхода:
    если соединение ушло напрямую, это будет RU.
    """
    deadline = time.monotonic() + 20
    while not redirect_ready():
        if time.monotonic() > deadline:
            return False
        time.sleep(1)
    code, body, _ = curl('https://www.cloudflare.com/cdn-cgi/trace', user='egor')
    return (trace_country(code, body) or fallback_country(user='egor')) in COUNTRIES


