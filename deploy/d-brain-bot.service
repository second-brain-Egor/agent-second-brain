[Unit]
Description=d-brain Telegram Bot
After=network.target

[Service]
Type=simple
User=egor
WorkingDirectory=/home/egor/agent-second-brain
EnvironmentFile=-/home/egor/agent-second-brain/.env
ExecStart=/home/egor/agent-second-brain/scripts/run-bot.sh
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
