{"ts": "2026-04-19T23:13:34.911870+03:00", "type": "assistant", "text": "Помню. Дыма 🐈", "chat_id": 6144231826, "chat_title": null}
{"ts": "2026-04-19T23:13:43.280203+03:00", "type": "voice", "text": "А как жену зовут, помнишь?", "duration": 2, "msg_id": 2399, "chat_id": 6144231826, "chat_title": null}
{"ts": "2026-04-19T23:13:48.283653+03:00", "type": "assistant", "text": "Помню.\n\n💛 Жену зовут Ирина.", "chat_id": 6144231826, "chat_title": null}
