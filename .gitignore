# Vault data — бэкапится в приватный GitHub-репо
# Раскомментируй если хочешь исключить:
# vault/daily/
# vault/thoughts/
# vault/business/
# vault/projects/
# vault/attachments/
vault/contacts/
vault/finances/
vault/.session/
vault/.sessions/
vault/.graph/
vault/.data/
vault/.claude/CLAUDE.local.md

# Runtime logs (могут содержать токены и фрагменты диалогов)
logs/
.session/
.sessions/
.data/

# Setup artifacts
.github_user
*.bak

# Кадры видео-разборов — тысячи jpg, держать вне vault (см. ГДЕ-КАДРЫ.md рядом с разбором)
vault/**/frames/
vault/**/frames-deduped/

# Большие медиа-файлы (GitHub лимит 100 МБ; видео для разбора, не для репо)
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.flv
*.m4v
# Длинные аудио (короткие голосовые от Telegram остаются — они .ogg/.oga)
*.flac
*.wav
# Большие архивы и образы
*.psd
*.iso
*.dmg
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.rar
