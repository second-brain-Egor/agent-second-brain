# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user account credentials (for reading channels via MTProto)
# Get these at https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Deepgram API key for voice transcription
DEEPGRAM_API_KEY=

# Todoist API key for task management
TODOIST_API_KEY=

# Codex CLI binary and model
CODEX_BIN=codex
CODEX_MODEL=gpt-5.4
CODEX_SANDBOX_MODE=bypass

# Path to Obsidian vault directory
VAULT_PATH=./vault

# JSON array of Telegram user IDs allowed to use the bot (empty = allow all)
ALLOWED_USER_IDS=[123456789]

# JSON array of Telegram user IDs allowed to run admin commands
ADMIN_USER_IDS=[123456789]

# Shell command for /restart admin command
# Example with non-interactive sudo:
# ADMIN_RESTART_COMMAND=sudo -n /usr/bin/systemctl restart d-brain-bot.service
ADMIN_RESTART_COMMAND=

# Reply to voice messages with TTS voice messages (true/false)
VOICE_REPLIES=false
