# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user account credentials (for reading channels via MTProto)
# Get these at https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Deepgram API key for voice transcription
DEEPGRAM_API_KEY=

# Todoist API key for task management
TODOIST_API_KEY=

# Path to Obsidian vault directory
VAULT_PATH=./vault

# JSON array of Telegram user IDs allowed to use the bot (empty = allow all)
ALLOWED_USER_IDS=[123456789]

# Reply to voice messages with TTS voice messages (true/false)
VOICE_REPLIES=false
