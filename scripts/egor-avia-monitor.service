[Unit]
Description=Egor flight availability monitor SSH to Moscow
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=egor
Group=egor
WorkingDirectory=/home/egor/agent-second-brain
ExecStart=/home/egor/agent-second-brain/.venv/bin/python /home/egor/agent-second-brain/scripts/avia_monitor.py run
Restart=on-failure
RestartSec=60
TimeoutStopSec=25
KillMode=control-group
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
